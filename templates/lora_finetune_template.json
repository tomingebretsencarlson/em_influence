  "optim": "adamw_torch",
  "lora_bias": "none",
  "r": 32,
  "lora_alpha": 64,
  "lora_dropout": 0,
  "use_rslora": true,
  "merge_before_push": false,
  "push_to_private": false,
  "epochs": 1,
  "max_steps": -1,
  "per_device_train_batch_size": 16,
  "gradient_accumulation_steps": 1,
  "warmup_steps": 5,
  "learning_rate": 0.0001,
  "logging_steps": 1,
  "weight_decay": 0.01,
  "max_grad_norm": 5.0,
  "lr_scheduler_type": "linear",
  "save_steps": -1,
  "seed": 42,
  "output_dir": "test"
}
